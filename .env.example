# Copy this file to .env and fill in your AWS credentials.
# docker-compose automatically reads .env from the same directory.
# Never commit .env to git.

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=            # only needed for temporary/assumed-role credentials

# Optional overrides — defaults are already set in docker-compose.yml
# AWS_REGION=eu-west-1
# SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:180571023460:alms-booking-topic
