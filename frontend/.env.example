# ─────────────────────────────────────────────────────────────────────────────
# DAMS Frontend environment configuration
#
# By default the app talks to same-origin "/api/*" paths which the Vite dev
# server proxies to each microservice (see vite.config.ts). You normally do NOT
# need to change these — they exist only if you want to point the built app at
# services reachable on a different host.
# ─────────────────────────────────────────────────────────────────────────────

VITE_AUTH_BASE_URL=/api/auth
VITE_FLIGHT_BASE_URL=/api/flight
VITE_BOOKING_BASE_URL=/api/booking
VITE_BAGGAGE_BASE_URL=/api/baggage
